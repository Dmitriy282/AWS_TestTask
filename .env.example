# Copy to .env and change the passwords: cp .env.example .env

# MySQL (PHP)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=change-me

# PostgreSQL (Python). pgadmin/servers.json expects POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_EXTRA_DATABASES=reports
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# MongoDB (Node.js)
MONGO_USER=app
MONGO_PASSWORD=change-me

# Redis — shared hit counter for all three apps. HITS_TTL is in seconds (259200 = 3 days)
REDIS_PASSWORD=change-me
HITS_TTL=259200

# pgAdmin login
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# Published host ports (defaults match the EC2 setup)
PHP_PORT=80
PYTHON_PORT=8000
NODE_PORT=8080
PHPMYADMIN_PORT=8081
PGADMIN_PORT=8082
