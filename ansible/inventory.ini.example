# Copy to inventory.ini and put the server address and the SSH key:
#   cp inventory.ini.example inventory.ini
# Not needed for ec2.yml — it adds the new instance to the `app` group by itself.

[app]
aws-testtask ansible_host=<EC2_PUBLIC_IP>

[app:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/<key>.pem
