# Infrastructure only: key pair, security group, EC2 instance.
# The secrets are in Vault (vault.tf). The software on the instance (swap, Docker, the stack) is installed by Ansible — see ../ansible.

data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }
}

data "http" "my_ip" {
  count = var.ssh_cidr == null ? 1 : 0
  url   = "https://checkip.amazonaws.com"
}

locals {
  ssh_cidr = var.ssh_cidr != null ? var.ssh_cidr : "${chomp(data.http.my_ip[0].response_body)}/32"
}

# ---------- key pair ----------
# The public half of the key generated in vault.tf; the private half is only in Vault
resource "aws_key_pair" "app" {
  key_name   = var.name
  public_key = data.vault_generic_secret.ssh_public.data["public_key"]
  tags       = { Name = var.name }
}

# ---------- security group ----------
resource "aws_security_group" "app" {
  name        = var.name
  description = "AWS_TestTask - SSH and the three sites"
  tags        = { Name = var.name }
}

resource "aws_vpc_security_group_ingress_rule" "ssh" {
  security_group_id = aws_security_group.app.id
  description       = "SSH"
  ip_protocol       = "tcp"
  from_port         = 22
  to_port           = 22
  cidr_ipv4         = local.ssh_cidr
}

resource "aws_vpc_security_group_ingress_rule" "web" {
  for_each = toset([for p in var.web_ports : tostring(p)])

  security_group_id = aws_security_group.app.id
  description       = "Sites"
  ip_protocol       = "tcp"
  from_port         = each.value
  to_port           = each.value
  cidr_ipv4         = "0.0.0.0/0"
}

# Terraform removes the default "allow all outbound" rule, so it is declared here
resource "aws_vpc_security_group_egress_rule" "all" {
  security_group_id = aws_security_group.app.id
  ip_protocol       = "-1"
  cidr_ipv4         = "0.0.0.0/0"
}

# ---------- instance ----------
resource "aws_instance" "app" {
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.instance_type
  key_name               = aws_key_pair.app.key_name
  vpc_security_group_ids = [aws_security_group.app.id]

  root_block_device {
    volume_size           = var.volume_gb
    volume_type           = "gp3"
    delete_on_termination = true
  }

  metadata_options {
    http_tokens = "required" # IMDSv2 only
  }

  tags = { Name = var.name }

  lifecycle {
    # a new Ubuntu AMI release must not replace the running server
    ignore_changes = [ami]
    # a new SSH key (secrets_version) reaches only a new instance: the old one keeps the old key in authorized_keys
    replace_triggered_by = [aws_key_pair.app]
  }
}

# ---------- Ansible inventory ----------
# Ansible reads every file in ansible/inventory/, so this host is added next to the bare-metal ones.
# The file is deleted by `terraform destroy`. ansible/site.yml writes the private key from Vault to ssh_key_file.
resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../ansible/inventory/aws.ini"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by Terraform (terraform/main.tf) — do not edit, it is overwritten on `terraform apply`
    [aws]
    ${var.name} ansible_host=${aws_instance.app.public_ip} ansible_user=ubuntu ansible_ssh_private_key_file=${var.ssh_key_file}

    [app:children]
    aws
  EOT
}
