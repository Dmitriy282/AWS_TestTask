# Secrets: the SSH key of the instance and the passwords of the stack.
# They are generated by ephemeral resources and written to Vault through write-only attributes,
# so they exist only in Vault — not in terraform.tfstate, not in git, not in a file.
# A secret is written once, when it is created or when secrets_version changes.

locals {
  app_passwords = toset([
    "MYSQL_ROOT_PASSWORD",
    "MYSQL_PASSWORD",
    "POSTGRES_PASSWORD",
    "MONGO_PASSWORD",
    "REDIS_PASSWORD",
    "PGADMIN_PASSWORD",
  ])
}

# ---------- SSH key ----------
ephemeral "tls_private_key" "ssh" {
  algorithm = "ED25519"
}

# secret/aws-testtask/ssh — read by Ansible (ansible/site.yml writes the key to ~/.ssh)
resource "vault_kv_secret_v2" "ssh" {
  mount               = var.vault_mount
  name                = "${var.vault_path}/ssh"
  delete_all_versions = true

  data_json_wo = jsonencode({
    private_key = ephemeral.tls_private_key.ssh.private_key_openssh
    public_key  = ephemeral.tls_private_key.ssh.public_key_openssh
  })
  data_json_wo_version = var.secrets_version
}

# secret/aws-testtask/ssh-public — the public key only. An ephemeral value cannot go into aws_key_pair,
# so Terraform reads it back from Vault; the data source keeps it in the state, which is fine for a public key.
resource "vault_kv_secret_v2" "ssh_public" {
  mount               = var.vault_mount
  name                = "${var.vault_path}/ssh-public"
  delete_all_versions = true

  data_json_wo = jsonencode({
    public_key = ephemeral.tls_private_key.ssh.public_key_openssh
  })
  data_json_wo_version = var.secrets_version
}

# (the data source vault_kv_secret_v2 is deprecated in provider 5.x; this one reads the same KV v2 secret)
data "vault_generic_secret" "ssh_public" {
  path = "${var.vault_mount}/${vault_kv_secret_v2.ssh_public.name}" # secret/aws-testtask/ssh-public (it adds /data/ itself)

  # the path is known at plan time; without this the secret would be read before it is written.
  # Both halves of the key: the key pair must never get a public key without its private key in Vault
  depends_on = [vault_kv_secret_v2.ssh_public, vault_kv_secret_v2.ssh]
}

# ---------- passwords of the stack ----------
ephemeral "random_password" "app" {
  for_each = local.app_passwords

  length  = 32
  special = false # they go into connection URLs (postgresql://user:password@...)
}

# secret/aws-testtask/app — read by Ansible (roles/app writes them to .env)
resource "vault_kv_secret_v2" "app" {
  mount               = var.vault_mount
  name                = "${var.vault_path}/app"
  delete_all_versions = true

  data_json_wo         = jsonencode({ for k in local.app_passwords : k => ephemeral.random_password.app[k].result })
  data_json_wo_version = var.secrets_version
}
