.env
node_modules/
__pycache__/
*.pyc
venv/
.venv/
*.pem
# Ansible inventory: aws.ini is written by Terraform, baremetal.ini by hand
ansible/inventory/*.ini

# Terraform (.terraform.lock.hcl is committed)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# Vault: unseal key, root token and the project token (written by vault/bootstrap.sh)
vault/.vault-init.json
vault/.vault-token
